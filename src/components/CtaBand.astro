---
import Monogram from './Monogram.astro';

interface Props {
  label?: string;
  title: string;
  body?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const {
  label = 'Now booking',
  title,
  body,
  primary = { label: 'Book a discovery call', href: '/contact' },
  secondary,
} = Astro.props;
---

<section class="band">
  <div class="shell">
    <div class="band__inner">
      <div class="band__mark" aria-hidden="true"><Monogram size={30} tone="pearl" /></div>

      <span class="label label--pink" data-reveal>{label}</span>
      <h2 class="band__title h2" data-split set:html={title} />
      {body && <p class="lead band__body" data-reveal>{body}</p>}

      <div class="actions band__actions" data-reveal>
        <a class="btn" href={primary.href}>
          {primary.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(3.5rem, 3rem + 4vw, 6rem);
  }

  .band__inner {
    position: relative;
    padding: clamp(2.25rem, 5vw, 4.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid rgb(239 238 240 / 0.16);
    background:
      radial-gradient(90% 140% at 8% 0%, rgb(110 60 255 / 0.55) 0%, rgb(110 60 255 / 0) 58%),
      linear-gradient(140deg, var(--violet-deep) 0%, #14103a 46%, var(--midnight-raised) 100%);
    overflow: hidden;
  }

  .band__inner::after {
    content: '';
    position: absolute;
    right: -6rem;
    bottom: -10rem;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 77 143 / 0.24) 0%, rgb(255 77 143 / 0) 68%);
    pointer-events: none;
  }

  .band__mark {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.25rem);
    right: clamp(1.5rem, 3vw, 2.25rem);
    opacity: 0.55;
  }

  .band__title {
    margin-top: 1rem;
    max-width: 20ch;
  }

  .band__title :global(em) {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
  }

  .band__body {
    margin-top: 1.25rem;
    color: rgb(239 238 240 / 0.76);
    max-width: 50ch;
  }

  .band__actions {
    margin-top: 2rem;
    position: relative;
  }
</style>
