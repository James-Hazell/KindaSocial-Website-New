---
import HeroBand from './HeroBand.astro';

/**
 * Interior page opener: the same full-bleed band the home page uses, with the
 * page's key facts as a strip beneath it. Every page opening the same way is
 * what makes a site feel like one site.
 */
interface Props {
  index: string;
  label: string;
  title: string;
  lede?: string;
  meta?: { k: string; v: string }[];
  src?: string;
  seed?: number;
}

const { index, label, title, lede, meta, src, seed } = Astro.props;
---

<HeroBand
  src={src}
  eyebrow={label}
  title={title}
  lede={lede}
  seed={seed ?? Number(index)}
  height="clamp(19rem, 46vh, 28rem)"
/>

{
  meta && (
    <div class="pmeta">
      <dl class="shell pmeta__inner">
        {meta.map((m) => (
          <div class="pmeta__item" data-reveal>
            <dt class="label">{m.k}</dt>
            <dd class="small">{m.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  .pmeta {
    border-bottom: 1px solid var(--line);
    background: var(--midnight-sunken);
  }

  .pmeta__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 48rem) {
    .pmeta__inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pmeta__item dd {
    margin-top: 0.45rem;
  }
</style>
