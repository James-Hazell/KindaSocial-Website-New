---
import fs from 'node:fs';
import path from 'node:path';
import Monogram from './Monogram.astro';

/**
 * Full-bleed image with a single line of type over it.
 *
 * These sit between the working sections as a breath — one idea, one picture,
 * nothing to read or click. The image drifts against the scroll, so the band
 * moves at a different rate to everything around it; that difference is most of
 * why a page feels considered rather than stacked.
 */
interface Props {
  src?: string;
  alt?: string;
  quote: string;
  attribution?: string;
  seed?: number;
  height?: string;
}

const { src, alt = '', quote, attribution, seed = 2, height = 'clamp(22rem, 56vh, 34rem)' } =
  Astro.props;

const exists = src ? fs.existsSync(path.join(process.cwd(), 'public', src.replace(/^\//, ''))) : false;
const uid = `iq${seed}-${Math.random().toString(36).slice(2, 7)}`;

// Cooler than the hero studies, so a page carrying both does not read as one
// long amber wash.
const tones = [
  { a: '#241d16', b: '#6b543c', c: '#c8a173' },
  { a: '#1b1f33', b: '#41476b', c: '#8d90b8' },
  { a: '#2a2119', b: '#7a5f42', c: '#d8b184' },
];
const t = tones[(seed - 1) % tones.length]!;
---

<section class="iq" style={`--iq-h:${height}`}>
  <div class="iq__media" aria-hidden={exists ? undefined : 'true'}>
    {
      exists ? (
        <img src={src} alt={alt} class="iq__img" data-parallax loading="lazy" decoding="async" />
      ) : (
        <svg class="iq__img" data-parallax viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id={`${uid}-g`} x1="0.15" y1="0" x2="0.9" y2="1">
              <stop offset="0%" stop-color={t.a} />
              <stop offset="52%" stop-color={t.b} />
              <stop offset="100%" stop-color={t.c} />
            </linearGradient>
            <linearGradient id={`${uid}-cast`} x1="0" y1="0" x2="0.55" y2="1">
              <stop offset="0%" stop-color="#12100c" stop-opacity="0.6" />
              <stop offset="100%" stop-color="#12100c" stop-opacity="0.1" />
            </linearGradient>
            <filter id={`${uid}-n`}>
              <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" />
              <feColorMatrix type="saturate" values="0" />
            </filter>
          </defs>
          <rect width="1600" height="900" fill={`url(#${uid}-g)`} />
          <g transform="rotate(18 800 450)">
            <rect x="-500" y="-620" width="2700" height="780" fill={`url(#${uid}-cast)`} />
          </g>
          <rect width="1600" height="900" filter={`url(#${uid}-n)`} opacity="0.05" />
        </svg>
      )
    }
    <span class="iq__scrim"></span>
  </div>

  <figure class="shell iq__inner">
    <div class="iq__mark" aria-hidden="true"><Monogram size={24} tone="pearl" /></div>
    <blockquote class="iq__quote" data-split set:html={quote} />
    {attribution && <figcaption class="label iq__by" data-reveal>{attribution}</figcaption>}
  </figure>
</section>

<style>
  .iq {
    position: relative;
    min-height: var(--iq-h);
    display: grid;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    border-block: 1px solid var(--line);
  }

  .iq__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .iq__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .iq__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 50%, rgb(10 18 40 / 0.76) 0%, rgb(10 18 40 / 0.3) 100%),
      linear-gradient(180deg, rgb(10 18 40 / 0.4) 0%, rgb(10 18 40 / 0.3) 50%, rgb(10 18 40 / 0.66) 100%);
  }

  .iq__inner {
    position: relative;
    /* Block only. A bare `margin: 0` to strip the figure default also wipes the
       `margin-inline: auto` .shell relies on, which pinned this band flush left
       with 200px of dead space beside it on any viewport past --shell. */
    margin-block: 0;
    text-align: center;
    padding-block: clamp(3rem, 7vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .iq__mark {
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .iq__quote {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 0.95rem + 2.4vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    max-width: 22ch;
    text-wrap: balance;
    color: var(--pearl);
  }

  .iq__quote :global(em) {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--chrome);
    letter-spacing: -0.01em;
  }

  .iq__by {
    margin-top: 1.75rem;
  }
</style>
