---
import fs from 'node:fs';
import path from 'node:path';

/**
 * Portrait frame.
 *
 * Drop a real photograph at `public/images/<file>` and it is used automatically.
 * Until then a golden-hour study renders in its place — same art direction as the
 * shoot (raking late light, a warm wall, the cast band of a window), so the layout never
 * looks unfinished and never looks like a stock placeholder.
 * See public/images/README.md.
 */
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  ratio?: string;
  seed?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** Set false to opt a frame out of the wipe-in (e.g. above the fold). */
  reveal?: boolean;
  /** Drift the picture against the scroll. For large frames, not thumbnails. */
  parallax?: boolean;
}

const {
  src,
  alt = '',
  caption,
  ratio = '3 / 4',
  seed = 1,
  class: className = '',
  loading = 'lazy',
  reveal = true,
  parallax = false,
} = Astro.props;

const exists = src ? fs.existsSync(path.join(process.cwd(), 'public', src.replace(/^\//, ''))) : false;

// Ten light studies, so a page carrying a dozen frames never repeats a panel.
// Deliberately architectural rather than figurative: the raking sun line, the
// warm pool, the cast band of a window frame — the light in the room, minus the
// person. Four run cool and two run near-monochrome, so a wall of frames is not
// a wall of the same amber.
const studies = [
  { shade: '#5d4b3c', warm: '#e3b981', glow: '#fdf3e0', angle: 24, bandX: 176, bandW: 62, poolX: 0.7, poolY: 0.74, pool: '#fff7e6' },
  { shade: '#4f4034', warm: '#d9ab72', glow: '#faedd9', angle: -16, bandX: 58, bandW: 48, poolX: 0.3, poolY: 0.66, pool: '#fff7e6' },
  { shade: '#6b5644', warm: '#eac693', glow: '#fff6e8', angle: 38, bandX: 122, bandW: 76, poolX: 0.58, poolY: 0.82, pool: '#fff7e6' },
  { shade: '#7a5a3e', warm: '#f0c489', glow: '#fff4e2', angle: 12, bandX: 210, bandW: 44, poolX: 0.8, poolY: 0.58, pool: '#ffeccd' },
  { shade: '#2f3350', warm: '#7d7fa8', glow: '#dcd9e8', angle: -28, bandX: 96, bandW: 58, poolX: 0.42, poolY: 0.7, pool: '#e8e4f6' },
  { shade: '#26304d', warm: '#6f74a2', glow: '#d3d2e4', angle: 30, bandX: 150, bandW: 70, poolX: 0.64, poolY: 0.78, pool: '#e2ddf4' },
  { shade: '#3d3a33', warm: '#9c9384', glow: '#e9e4d8', angle: -6, bandX: 30, bandW: 84, poolX: 0.22, poolY: 0.84, pool: '#f4efe3' },
  { shade: '#1f2a2b', warm: '#5d7c7a', glow: '#cfe0dc', angle: 46, bandX: 196, bandW: 52, poolX: 0.74, poolY: 0.4, pool: '#dff0ea' },
  { shade: '#4a3550', warm: '#9b789f', glow: '#efdfef', angle: -38, bandX: 118, bandW: 40, poolX: 0.5, poolY: 0.6, pool: '#f7e8f6' },
  { shade: '#33322f', warm: '#8a857c', glow: '#ddd9d2', angle: 18, bandX: 236, bandW: 36, poolX: 0.86, poolY: 0.72, pool: '#eeeae2' },
];
const s = studies[(seed - 1) % studies.length]!;
const uid = `p${seed}-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class:list={['portrait', className]} style={`--ratio:${ratio}`}>
  <div class="portrait__frame" data-reveal={reveal ? 'media' : undefined}>
    {
      exists ? (
        <img src={src} alt={alt} loading={loading} decoding="async" class="portrait__img" data-parallax={parallax ? "" : undefined} />
      ) : (
        <svg
          class="portrait__study"
          data-parallax={parallax ? '' : undefined}
          viewBox="0 0 300 400"
          preserveAspectRatio="xMidYMid slice"
          role="img"
          aria-label={alt || 'Portrait placeholder'}>
          <defs>
            <linearGradient id={`${uid}-wall`} x1="0.1" y1="0" x2="0.75" y2="1">
              <stop offset="0%" stop-color={s.shade} />
              <stop offset="46%" stop-color={s.warm} />
              <stop offset="100%" stop-color={s.glow} />
            </linearGradient>
            <linearGradient id={`${uid}-cast`} x1="0" y1="0" x2="0.6" y2="1">
              <stop offset="0%" stop-color="#241a12" stop-opacity="0.5" />
              <stop offset="100%" stop-color="#241a12" stop-opacity="0.14" />
            </linearGradient>
            <linearGradient id={`${uid}-band`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2b2015" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#2b2015" stop-opacity="0.02" />
            </linearGradient>
            <radialGradient id={`${uid}-pool`} cx={s.poolX} cy={s.poolY} r="0.58">
              <stop offset="0%" stop-color={s.pool} stop-opacity="0.62" />
              <stop offset="100%" stop-color={s.pool} stop-opacity="0" />
            </radialGradient>
            <filter id={`${uid}-soft`} x="-25%" y="-25%" width="150%" height="150%">
              <feGaussianBlur stdDeviation="5" />
            </filter>
            <filter id={`${uid}-grain`}>
              <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" />
              <feColorMatrix type="saturate" values="0" />
            </filter>
          </defs>

          {/* the wall */}
          <rect width="300" height="400" fill={`url(#${uid}-wall)`} />

          {/* the cast band of a window frame, softened */}
          <g filter={`url(#${uid}-soft)`}>
            <rect x={s.bandX} y="-40" width={s.bandW} height="470" fill={`url(#${uid}-band)`} />
          </g>

          {/* the hard sun line raking across it */}
          <g transform={`rotate(${s.angle} 150 150)`}>
            <rect x="-160" y="-260" width="620" height="286" fill={`url(#${uid}-cast)`} />
          </g>

          {/* the warm pool where the light lands */}
          <rect width="300" height="400" fill={`url(#${uid}-pool)`} />

          <rect width="300" height="400" filter={`url(#${uid}-grain)`} opacity="0.05" />
        </svg>
      )
    }
  </div>

  {
    caption && (
      <figcaption class="portrait__caption" data-reveal={reveal ? '' : undefined}>
        <span class="label">{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .portrait {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .portrait__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--midnight-raised);
    border: 1px solid var(--line);
  }

  .portrait__img,
  .portrait__study {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait__caption {
    padding-left: 0.1rem;
  }
</style>
