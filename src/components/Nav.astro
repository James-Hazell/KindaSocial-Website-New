---
import Wordmark from './Wordmark.astro';
import Monogram from './Monogram.astro';
import { nav, site, services } from '~/data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="nav" data-nav>
  <div class="nav__bar shell">
    <a class="nav__brand" href="/" aria-label={`${site.name} — home`}>
      <Wordmark size="1.4rem" />
      <span class="nav__tagline">A content &amp; growth studio</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        nav.map((item) =>
          item.href === '/services' ? (
            <div class="nav__has-menu" data-menu>
              <a
                class:list={['nav__link', isCurrent(item.href) && 'is-current']}
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                class="nav__caret"
                type="button"
                aria-expanded="false"
                aria-controls="services-menu"
                data-menu-toggle>
                <span class="visually-hidden">Show services</span>
                <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </button>

              <div class="mega" id="services-menu" data-menu-panel>
                <ul class="mega__list">
                  {services.map((s) => (
                    <li>
                      <a href={`/services#svc-${s.n}`}>
                        <span class="mega__n">{s.n}</span>
                        {s.title}
                      </a>
                    </li>
                  ))}
                  <li class="mega__all">
                    <a href="/services">
                      All services
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          ) : (
            <a
              class:list={['nav__link', isCurrent(item.href) && 'is-current']}
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ),
        )
      }
      <a class:list={['nav__link', 'nav__link--cta', isCurrent('/contact') && 'is-current']} href="/contact">
        Apply now
      </a>
    </nav>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      data-nav-toggle>
      <span class="nav__toggle-label" data-nav-label>Menu</span>
      <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="visually-hidden">Toggle navigation</span>
    </button>
  </div>

  <!-- Mobile panel: designed for the phone, not the desktop menu shrunk down. -->
  <div class="panel" id="nav-panel" data-nav-panel hidden>
    <div class="panel__inner shell">
      <ul class="panel__list">
        {
          nav.map((item, i) => (
            <li class="panel__item">
              <a href={item.href} class:list={[isCurrent(item.href) && 'is-current']}>
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <span class="panel__label">{item.label}</span>
                <span class="panel__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="panel__foot">
        <a class="btn btn--caps panel__cta" href="/contact">
          Apply for a slot
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <div class="panel__meta">
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="link" href={site.instagram.url} rel="noopener">{site.instagram.handle}</a>
        </div>
        <div class="panel__mark"><Monogram size={22} tone="chrome" /></div>
      </div>
    </div>
  </div>
</header>

<style>
  /* A solid band, always. The reference never lets content run under the
     header, and the permanence is most of what makes it read as a masthead. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--midnight);
    border-bottom: 1px solid var(--line);
    transition:
      translate 520ms var(--ease-out),
      min-height 420ms var(--ease-out);
  }

  /* Out of the way while reading, back the moment they scroll up. */
  .nav.is-tucked {
    translate: 0 -101%;
  }

  .nav.is-open {
    translate: 0;
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding-block: 0.75rem;
  }

  @media (min-width: 62rem) {
    .nav__bar {
      min-height: 5.5rem;
      transition: min-height 420ms var(--ease-out);
    }

    /* Tightens once past the hero — subtle, but it is the difference between
       a header that sits there and one that responds. */
    .nav.is-scrolled .nav__bar {
      min-height: 4.5rem;
    }
  }

  /* Logo + tagline lockup */
  .nav__brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-shrink: 0;
  }

  .nav__tagline {
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--chrome);
    padding-left: 0.12rem;
  }

  @media (min-width: 62rem) {
    .nav__tagline {
      font-size: 0.625rem;
    }
  }

  .nav__links {
    display: none;
  }

  @media (min-width: 62rem) {
    .nav__links {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
  }

  .nav__link {
    position: relative;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pearl);
    padding-block: 0.5rem;
    white-space: nowrap;
    transition: color 300ms var(--ease);
  }

  /* The reference marks the active item with a rule beneath it. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    scale: 0 1;
    transform-origin: left center;
    transition: scale 380ms var(--ease);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-current::after {
    scale: 1 1;
  }

  .nav__link--cta {
    color: var(--pink);
  }

  /* Services dropdown */
  .nav__has-menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav__caret {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0.4rem 0.1rem;
    color: var(--pearl);
    cursor: pointer;
  }

  .nav__caret svg {
    transition: transform 320ms var(--ease);
  }

  .nav__has-menu.is-open .nav__caret svg {
    transform: rotate(180deg);
  }

  .mega {
    position: absolute;
    top: calc(100% + 1.1rem);
    left: -1.25rem;
    min-width: 21rem;
    padding: 0.5rem 0;
    background: var(--midnight-raised);
    border: 1px solid var(--line);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition:
      opacity 260ms var(--ease),
      translate 260ms var(--ease),
      visibility 260ms;
  }

  .nav__has-menu.is-open .mega {
    opacity: 1;
    visibility: visible;
    translate: 0;
  }

  .mega__list a {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--chrome);
    transition:
      color 220ms var(--ease),
      background-color 220ms var(--ease);
  }

  .mega__list a:hover,
  .mega__list a:focus-visible {
    color: var(--pearl);
    background: rgb(239 238 240 / 0.05);
  }

  .mega__n {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--pink);
    font-variant-numeric: tabular-nums;
  }

  .mega__all {
    margin-top: 0.35rem;
    border-top: 1px solid var(--line);
  }

  .mega__all a {
    justify-content: space-between;
    color: var(--pearl);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--t-label);
  }

  /* Toggle */
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 0;
    padding: 0.5rem 0;
    cursor: pointer;
    color: var(--pearl);
  }

  @media (min-width: 62rem) {
    .nav__toggle {
      display: none;
    }
  }

  .nav__toggle-label {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav__bars {
    display: grid;
    gap: 5px;
    width: 20px;
  }

  .nav__bars i {
    display: block;
    height: 1.5px;
    background: var(--pearl);
    transition: transform 380ms var(--ease);
  }

  .nav.is-open .nav__bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav.is-open .nav__bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile panel */
  .panel {
    position: fixed;
    inset: 4.25rem 0 0;
    background: var(--midnight);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }

  .panel[hidden] {
    display: none;
  }

  .panel.is-visible {
    opacity: 1;
  }

  .panel__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 1.5rem 2.5rem;
  }

  .panel__list {
    border-top: 1px solid var(--line);
  }

  .panel__item a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  .panel__label {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .panel__arrow {
    color: var(--chrome);
    font-size: 1.125rem;
  }

  .panel__item a.is-current .panel__arrow {
    color: var(--pink);
  }

  .panel__foot {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .panel__cta {
    justify-content: center;
  }

  .panel__meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .panel__mark {
    padding-top: 0.5rem;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');

  if (header && toggle && panel && label) {
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      header.classList.toggle('is-open', next);
      label.textContent = next ? 'Close' : 'Menu';
      document.body.style.overflow = next ? 'hidden' : '';

      if (next) {
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-visible'));
      } else {
        panel.classList.remove('is-visible');
        const done = () => {
          if (!open) panel.hidden = true;
          panel.removeEventListener('transitionend', done);
        };
        panel.addEventListener('transitionend', done);
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });

    const mq = window.matchMedia('(min-width: 62rem)');
    mq.addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }

  // Services dropdown. Opens on hover for pointers and on click/focus for
  // everyone else, so it is never a mouse-only affordance.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (menu && menuToggle) {
    let menuOpen = false;
    const setMenu = (next: boolean) => {
      menuOpen = next;
      menu.classList.toggle('is-open', next);
      menuToggle.setAttribute('aria-expanded', String(next));
    };

    menuToggle.addEventListener('click', () => setMenu(!menuOpen));
    menu.addEventListener('mouseenter', () => setMenu(true));
    menu.addEventListener('mouseleave', () => setMenu(false));
    menu.addEventListener('focusin', () => setMenu(true));

    menu.addEventListener('focusout', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) setMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) {
        setMenu(false);
        menuToggle.focus();
      }
    });
  }
</script>
