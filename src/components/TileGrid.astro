---
import Portrait from './Portrait.astro';

/**
 * Photo tiles with the caption laid directly on the image.
 *
 * No card, no border, no radius — the reference sets white uppercase type on
 * the lower-left of the photograph itself, and the absence of chrome is what
 * makes it read as editorial rather than as a component library.
 */
interface Props {
  items: readonly { caption: string; alt: string; seed: number; src?: string }[];
  columns?: 2 | 4;
}

const { items, columns = 2 } = Astro.props;
---

<ul class:list={['tiles', `tiles--${columns}`]}>
  {
    items.map((t) => (
      <li class="tile" data-reveal="media">
        <Portrait src={t.src} alt={t.alt} ratio="4 / 3" seed={t.seed} reveal={false} />
        <span class="tile__scrim" aria-hidden="true" />
        <p class="tile__caption">{t.caption}</p>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .tiles--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .tiles--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 72rem) {
    .tiles--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tile {
    position: relative;
    overflow: hidden;
  }

  .tile :global(.portrait__frame) {
    border: 0;
  }

  /* Bottom-weighted so the caption always has contrast, whatever the photo. */
  .tile__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(10 18 40 / 0) 38%,
      rgb(10 18 40 / 0.55) 68%,
      rgb(10 18 40 / 0.88) 100%
    );
  }

  .tile__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.85rem + 0.35vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--pearl);
    text-wrap: pretty;
  }
</style>
