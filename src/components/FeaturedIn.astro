---
/**
 * The press band — centred heading, then a continuous rail of placements.
 *
 * Names are set in type, not reproduced as logo files. Each `face` picks a
 * treatment that evokes the real wordmark (Forbes and the FT are serif caps,
 * Vogue is letterspaced serif, TED and NBC are tight sans caps), which reads
 * as a logo row without redrawing anyone's trademark.
 *
 * Content lives in `featuredIn` in site.ts. Read the note there before editing:
 * the claim is that clients were featured, not the agency.
 */
import { featuredIn } from '~/data/site';

interface Props {
  tone?: 'dark' | 'pearl';
  headline?: string;
}

const { tone = 'dark', headline = featuredIn.headline } = Astro.props;
const items = featuredIn.items;
---

{
  items.length > 0 && (
    <section class:list={['fi', `fi--${tone}`]} aria-label="Press and media placements">
      <div class="shell">
        <h2 class="fi__headline" data-reveal="text">
          {headline}
        </h2>
      </div>

      <div class="fi__rail" tabindex="0" role="group" aria-label="Publications our clients have appeared in">
        {[0, 1].map((copy) => (
          <ul class="fi__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((item) => (
              <li class:list={['fi__item', `is-${item.face}`]}>{item.name}</li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}

<style>
  .fi {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    border-block: 1px solid var(--line);
    background: var(--midnight-sunken);
    overflow: hidden;
  }

  .fi--pearl {
    background: var(--pearl);
    border-color: var(--line-dark);
  }

  .fi__headline {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.05rem + 1.9vw, 2.375rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    max-width: 24ch;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    color: var(--pearl);
  }

  .fi--pearl .fi__headline {
    color: var(--ink);
  }

  .fi__rail {
    display: flex;
    width: max-content;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .fi__track {
    display: flex;
    align-items: center;
    animation: fi-slide 52s linear infinite;
  }

  @keyframes fi-slide {
    to {
      transform: translateX(-100%);
    }
  }

  .fi:hover .fi__track,
  .fi__rail:focus-within .fi__track {
    animation-play-state: paused;
  }

  .fi__item {
    flex-shrink: 0;
    white-space: nowrap;
    padding-inline: clamp(1.5rem, 3.5vw, 3rem);
    color: var(--pearl);
    line-height: 1.1;
    /* One optical size for the row; the faces below vary within it. */
    font-size: clamp(1.375rem, 0.95rem + 1.7vw, 2.25rem);
  }

  .fi--pearl .fi__item {
    color: var(--ink);
  }

  /* Wordmark treatments */
  .is-sans {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .is-sans-caps {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .is-serif-caps {
    font-family: var(--font-editorial);
    font-style: normal;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .is-serif-wide {
    font-family: var(--font-editorial);
    font-style: normal;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  @media (prefers-reduced-motion: reduce) {
    .fi__rail {
      width: 100%;
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .fi__track {
      animation: none;
    }

    .fi__track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
