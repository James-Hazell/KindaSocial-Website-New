---
import Base from '~/layouts/Base.astro';
import HeroBand from '~/components/HeroBand.astro';
import SectionHead from '~/components/SectionHead.astro';
import Portrait from '~/components/Portrait.astro';
import Marquee from '~/components/Marquee.astro';
import FeaturedIn from '~/components/FeaturedIn.astro';
import TestimonialRail from '~/components/TestimonialRail.astro';
import SocialTile from '~/components/SocialTile.astro';
import TileGrid from '~/components/TileGrid.astro';
import CityStrip from '~/components/CityStrip.astro';
import ImageQuote from '~/components/ImageQuote.astro';
import CtaBand from '~/components/CtaBand.astro';
import { services, results, differences, proofPoints, process, workTiles, clientTypes } from '~/data/site';
---

<Base
  title="KindaSocial — the ecosystem behind the personal brands you actually follow"
  suffix={false}>
  <!-- ============================================ hero -->
  <HeroBand
    src="/images/hero.jpg"
    alt="A KindaSocial client filming to camera"
    eyebrow="Now booking · two creator slots"
    title="You stay on camera.<br />We run <em>the machine</em>."
    lede="KindaSocial is the back office for personal brands. Strategy, content, distribution and the inbox — run by us, so the expert can go back to being the expert."
    seed={1}>
    <a class="btn btn--caps" href="/contact">
      Apply for a slot
      <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
    <a class="btn btn--caps btn--ghost" href="/results">See the numbers</a>
  </HeroBand>

  <section class="section--tight">
    <div class="shell">
      <dl class="stats">
        <div class="stats__item" data-reveal>
          <dt class="label">Own account</dt>
          <dd>
            <span class="stat__figure tnum"><span data-count>800</span> → <span data-count>40</span>k</span>
            <span class="stat__caption">Followers in under six months, before we sold the method.</span>
          </dd>
        </div>
        <div class="stats__item" data-reveal>
          <dt class="label">Client account</dt>
          <dd>
            <span class="stat__figure tnum"><span data-count>49</span>k → <span data-count>156</span>k</span>
            <span class="stat__caption">Six months of one filming rhythm and platform-native cuts.</span>
          </dd>
        </div>
        <div class="stats__item" data-reveal>
          <dt class="label">Roster</dt>
          <dd>
            <span class="stat__figure tnum">Capped</span>
            <span class="stat__caption">Amy directs every account. That is why the number is small.</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <FeaturedIn />

  <!-- ============================================ who we work with -->
  <section class="section on-pearl who">
    <div class="shell">
      <SectionHead
        label="Who we work with"
        title="Experts, not accounts."
        aside="A short list on purpose. The roster is capped because Amy directs every account, so the people on it have something in common."
      />
      <TileGrid items={clientTypes} columns={4} />
    </div>
  </section>

  <!-- ============================================ the problem -->
  <section class="section problem">
    <div class="shell rail">
      <aside class="rail__aside">
        <span class="label" data-reveal>The problem</span>
        <span class="index" data-reveal>/ 0 1</span>
      </aside>

      <div class="rail__main">
        <h2 class="h2 problem__title" data-reveal="text">
          Everyone in your niche sounds identical. That is not a content problem, it is a
          <span class="editorial accent-pink">positioning</span> one.
        </h2>

        <p class="lead problem__lede" data-reveal>
          AI made content cheap, and now it reads cheap. The feed is full of experts saying the same
          eight things in the same nine seconds. Attention is easy. Authority that books calls is
          the hard part.
        </p>

        <ul class="pains">
          <li class="pain" data-reveal>
            <span class="pain__quote">“I am too busy being the expert to make content.”</span>
            <span class="pain__answer">One filming session a month. We handle the other ninety percent.</span>
          </li>
          <li class="pain" data-reveal>
            <span class="pain__quote">“It gets likes and it does not turn into clients.”</span>
            <span class="pain__answer">Every post points at an offer, and every conversation gets traced back.</span>
          </li>
          <li class="pain" data-reveal>
            <span class="pain__quote">“I post in bursts, then vanish for three weeks.”</span>
            <span class="pain__answer">A rhythm you do not have to remember, because it is not your job.</span>
          </li>
          <li class="pain" data-reveal>
            <span class="pain__quote">“Whatever an agency writes will not sound like me.”</span>
            <span class="pain__answer">Two weeks of voice work before a single thing is published.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <ImageQuote
    src="/images/quote-home.jpg"
    quote="Talent makes the content.<br />We make <em>the machine</em> that makes the talent."
    attribution="The whole model, in one line"
    seed={1}
  />

  <Marquee items={proofPoints} />

  <!-- ============================================ services -->
  <section class="section on-pearl services" id="what-we-do">
    <div class="shell">
      <SectionHead
        label="What we do"
        title="Six jobs. One machine."
        aside="Every part connects to the next. Strategy tells production what to make, production feeds distribution, distribution fills the inbox, and the inbox tells strategy what to do next month."
      />

      <ol class="rows services__list">
        {
          services.map((s) => (
            <li class="row service" data-reveal>
              <span class="index">{s.n}</span>
              <div class="service__head">
                <h3 class="h3">{s.title}</h3>
                <p class="service__lede">{s.lede}</p>
              </div>
              <p class="service__body">{s.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="services__foot" data-reveal>
        <a class="link" href="/services">
          Full scope, deliverable by deliverable
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ the work -->
  <section class="section work">
    <div class="shell">
      <SectionHead
        label="The work"
        title="One system, four jobs."
        aside="Every asset comes off the same template set, so an account looks like one brand rather than twelve moods. These are the live templates, not screenshots of them."
      />

      <div
        class="work__grid"
        tabindex="0"
        role="group"
        aria-label="Social post templates">
        {
          workTiles.map((t) => (
            <div class="work__cell" data-reveal="media">
              <SocialTile kind={t.kind} eyebrow={t.eyebrow} headline={t.headline} foot={t.foot} />
            </div>
          ))
        }
      </div>

      <div class="work__foot" data-reveal>
        <a class="link" href="/services#svc-06">
          How the brand system gets built
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ proof -->
  <section class="section proof">
    <div class="shell">
      <SectionHead
        label="Proof"
        title="Receipts, not adjectives."
        aside="Two accounts, the same method. The mechanism is in the write-up, not just the screenshot."
      />

      <div class="cases">
        {
          results.map((r) => (
            <article class="case" data-reveal>
              <div class="case__top">
                <span class="index">{r.n}</span>
                <span class="label label--bare">{r.discipline}</span>
              </div>

              <div class="case__figure">
                <span class="case__from tnum">{r.from}</span>
                <span class="case__arrow" aria-hidden="true">
                  →
                </span>
                <span class="case__to tnum">{r.to}</span>
              </div>

              <p class="case__unit label label--bare">
                {r.unit} · {r.window}
              </p>

              <p class="body case__summary">{r.summary}</p>

              <a class="link case__link" href="/results">
                Read the breakdown
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ how it works -->
  <section class="section how">
    <div class="shell how__grid">
      <div class="how__media">
        <Portrait
          src="/images/batch-day.jpg"
          alt="A KindaSocial batch day in progress"
          caption="Batch day · one session covers the month"
          ratio="3 / 4"
          seed={2}
        />
      </div>

      <div class="how__body">
        <SectionHead
          align="left"
          index="04"
          label="How it works"
          title="Five steps. You are needed for two."
        />

        <ol class="steps">
          {
            process.map((p) => (
              <li class="step" data-reveal>
                <div class="step__rail" aria-hidden="true">
                  <span class="step__dot" />
                </div>
                <div class="step__body">
                  <div class="step__head">
                    <h3 class="h4">
                      <span class="index step__n">{p.n}</span> {p.title}
                    </h3>
                    <span class="label label--bare step__when">{p.duration}</span>
                  </div>
                  <p class="body">{p.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================ why us -->
  <section class="section why">
    <div class="shell">
      <SectionHead
        label="Why this one"
        title="Sharp where the rest are beige."
        aside="Clients pick the agency that is visibly better at the thing they are hiring for. This is ours."
      />

      <div class="why__grid">
        {
          differences.map((d) => (
            <article class="why__card card" data-reveal>
              <span class="index">{d.n}</span>
              <h3 class="h4 why__title">{d.title}</h3>
              <p class="body why__body">{d.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ testimonials -->
  <section class="section on-pearl voices">
    <div class="shell">
      <SectionHead
        label="Client said"
        title="The line we hear most."
        aside="Hover to hold one still."
      />
    </div>

    <TestimonialRail tone="pearl" />
  </section>

  <ImageQuote
    src="/images/quote-proof.jpg"
    quote="Every booked call, traced back to <em>the post that caused it</em>."
    attribution="What the monthly read-out leads with"
    seed={2}
  />

  <CityStrip />

  <CtaBand
    label="Now booking · Q3"
    title="Two creator slots open.<br />Apply at the link."
    body="A thirty-minute call. We look at your audience, your offer and what you have already tried. If we are not the right fit we will say so on the call."
    secondary={{ label: 'See pricing', href: '/pricing' }}
  />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 2rem + 5vw, 5rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4.4fr);
      align-items: center;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }

  .hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 1.5rem + 5.2vw, 5.25rem);
  }

  .hero__title .editorial {
    color: var(--chrome);
  }

  .hero__lede {
    margin-top: 1.75rem;
    max-width: 44ch;
  }

  .hero__actions {
    margin-top: 2.25rem;
  }

  /* The cluster: main frame, plus a square inset overlapping its lower-left. */
  .hero__cluster {
    position: relative;
    padding-left: 2.75rem;
  }

  .hero__cluster :global(.hero__shot--main) {
    margin-left: auto;
    width: 100%;
    max-width: 22rem;
  }

  .hero__cluster :global(.hero__shot--inset) {
    position: absolute;
    left: 0;
    /* Sits against the lower third of the main frame, clear of its caption. */
    bottom: 3.25rem;
    width: 46%;
    max-width: 9.5rem;
  }

  .hero__cluster :global(.hero__shot--inset .portrait__frame) {
    border-color: var(--line-strong);
    box-shadow: 0 24px 60px -20px rgb(7 13 29 / 0.9);
  }

  /* Phones get one frame. Two overlapping at 390px is a puzzle, not a layout. */
  @media (max-width: 47.99rem) {
    .hero__cluster {
      padding: 0;
      display: flex;
      gap: 0.85rem;
      align-items: flex-end;
    }

    .hero__cluster :global(.hero__shot--main) {
      max-width: 62%;
      margin-left: 0;
    }

    .hero__cluster :global(.hero__shot--inset) {
      position: static;
      width: auto;
      flex: 1;
      max-width: none;
    }
  }

  .stats {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }
  }

  .stats__item dd {
    margin: 0.85rem 0 0;
    display: flex;
    flex-direction: column;
  }

  /* ---------- problem ---------- */
  .problem__title {
    max-width: 20ch;
  }

  .problem__title .editorial {
    font-weight: 400;
  }

  .problem__lede {
    margin-top: 1.75rem;
    max-width: 54ch;
  }

  .pains {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .pain {
    display: grid;
    gap: 0.6rem 2.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .pain {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .pain__quote {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--pearl);
  }

  .pain__answer {
    font-size: var(--t-small);
    color: var(--chrome);
    position: relative;
    padding-left: 1.25rem;
  }

  .pain__answer::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 1px;
    background: var(--pink);
  }

  /* ---------- services ---------- */
  .service__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service__lede {
    font-size: var(--t-small);
    color: var(--ink-muted);
    max-width: 32ch;
  }

  .service__body {
    color: var(--ink-muted);
    font-size: var(--t-small);
    max-width: 54ch;
  }

  .services__foot {
    margin-top: 2.5rem;
  }

  /* ---------- the work ---------- */
  /*
   * Below the four-up breakpoint these become a snap rail rather than a grid.
   * A 1:1 tile in a 2-up grid at phone width is ~165px, which is not enough
   * room for the headline it has to carry — the type clips. Swiping through
   * them full-size is also how these get looked at in the first place.
   */
  .work__grid {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    /* Bleed to the screen edges so a tile is visibly cut off, cueing the swipe. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .work__grid > .work__cell {
    flex: 0 0 auto;
    width: min(19rem, 68vw);
    scroll-snap-align: start;
  }

  .work__grid:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  @media (min-width: 62rem) {
    .work__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }

    .work__grid > .work__cell {
      width: auto;
    }
  }

  .work__foot {
    margin-top: 2.5rem;
  }

  /* ---------- proof ---------- */
  .cases {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56rem) {
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(170deg, var(--midnight-raised) 0%, var(--midnight) 70%);
  }

  .case__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .case__figure {
    margin-top: 1.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .case__from {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    color: var(--chrome);
  }

  .case__arrow {
    color: var(--pink);
    font-size: 1.125rem;
  }

  .case__to {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }

  .case__unit {
    margin-top: 0.85rem;
  }

  .case__summary {
    margin-top: 1.5rem;
    font-size: var(--t-small);
    flex: 1;
  }

  .case__link {
    margin-top: 1.75rem;
    align-self: flex-start;
  }

  /* ---------- how ---------- */
  .how__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 62rem) {
    .how__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }

    .how__media {
      position: sticky;
      top: 8rem;
    }
  }

  .how__media {
    max-width: 24rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
  }

  .step {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .step__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .step__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .step:first-child .step__rail::before {
    top: 0.7rem;
  }

  .step:last-child .step__rail::before {
    bottom: auto;
    height: 0.7rem;
  }

  .step__dot {
    position: relative;
    margin-top: 0.55rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--midnight);
    border: 1px solid var(--chrome);
  }

  .step:first-child .step__dot {
    background: var(--pink);
    border-color: var(--pink);
  }

  .step__body {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .step__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.65rem;
  }

  .step__n {
    margin-right: 0.5rem;
    color: var(--chrome);
  }

  .step__body .body {
    font-size: var(--t-small);
    max-width: 56ch;
  }

  /* ---------- why ---------- */
  .why__grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .why__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .why__title {
    margin-top: 1.75rem;
    max-width: 18ch;
  }

  .why__body {
    margin-top: 0.85rem;
    font-size: var(--t-small);
  }

  /* ---------- voices ---------- */
  /* The rail runs full-bleed; only its heading sits in the shell. */
  .voices {
    overflow: hidden;
  }
</style>
