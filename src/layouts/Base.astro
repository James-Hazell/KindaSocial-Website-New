---
import '~/styles/fonts.css';
import '~/styles/global.css';

import TopBar from '~/components/TopBar.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ScrollTop from '~/components/ScrollTop.astro';
import Motion from '~/components/Motion.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '~/data/site';

interface Props {
  title: string;
  description?: string;
  /** Appended after the page title. Set false for the home page. */
  suffix?: boolean;
  ogImage?: string;
}

const {
  title,
  description = site.description,
  suffix = true,
  ogImage = '/images/og-default.png',
} = Astro.props;

const pageTitle = suffix ? `${title} — ${site.name}` : title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  slogan: site.tagline,
  founder: { '@type': 'Person', name: site.founder },
  email: site.email,
  areaServed: site.regions,
  sameAs: [site.instagram.url, site.linkedin.url],
  serviceType: 'Personal brand strategy, content production and social media growth',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#0a1228" />
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <TopBar />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollTop />

    <Motion />
  </body>
</html>
