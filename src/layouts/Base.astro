---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '~/styles/global.css';

import TopBar from '~/components/TopBar.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ScrollTop from '~/components/ScrollTop.astro';
import { site } from '~/data/site';

interface Props {
  title: string;
  description?: string;
  /** Appended after the page title. Set false for the home page. */
  suffix?: boolean;
  ogImage?: string;
}

const {
  title,
  description = site.description,
  suffix = true,
  ogImage = '/images/og-default.png',
} = Astro.props;

const pageTitle = suffix ? `${title} — ${site.name}` : title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  slogan: site.tagline,
  founder: { '@type': 'Person', name: site.founder },
  email: site.email,
  areaServed: site.regions,
  sameAs: [site.instagram.url, site.linkedin.url],
  serviceType: 'Personal brand strategy, content production and social media growth',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#0a1228" />
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <TopBar />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollTop />

    <script>
      // Whisper-level reveal. Nothing moves more than 12px, nothing bounces.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        // Stagger is counted per section, not across the document. A global index
        // means the tenth section starts mid-sequence and the last items sit
        // waiting out a delay they did nothing to earn.
        const seen = new Map<Element, number>();

        targets.forEach((el) => {
          if (el.style.getPropertyValue('--reveal-delay')) return;
          const group = el.closest('section, footer, header') ?? document.body;
          const i = seen.get(group) ?? 0;
          seen.set(group, i + 1);
          el.style.setProperty('--reveal-delay', `${Math.min(i, 7) * 70}ms`);
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 },
        );

        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
